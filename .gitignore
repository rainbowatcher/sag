# Created by https://www.toptal.com/developers/gitignore/api/rust
# Edit at https://www.toptal.com/developers/gitignore?templates=rust

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# End of https://www.toptal.com/developers/gitignore/api/rust

*.db
*.db-shm
*.db-wal
dist
node_modules

# Vue SFC pre-compiled outputs (*.vue → *.vue.js) — generated by Vite/build tooling,
# should not be committed. Check in the .vue source instead.
*.vue.js

# TypeScript incremental build cache — regenerated by `tsc` and `vue-tsc`.
*.tsbuildinfo

# ai agents
.kilo/
.cline/
.kimchi/
.qoder/
.claude/
.mimocode/
.openclaude/
.zcode/
.pi-subagents/
.pi/
.workbuddy/
.codebuddy/

# test-env state (Phase 2 — see .plan/test-environment.md)
.test-env/
gateway.test.toml
logs/
# analytics-test.db is already covered by the `*.db` pattern above.

# python
__pycache__/

# VitePress 缓存与构建产物
docs/.vitepress/cache
docs/.vitepress/dist

# misc
.agent-reports/
.plan/
gateway.toml
PLAN.md
