    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "histoire": "1.0.0-beta.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.74.0",
    "postcss": "^8.5.19",
    "shadcn-vue": "^2.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.7"
