{
  "name": "sag-ui",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-compress.mjs",
    "preview": "vite preview",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt .",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:active-target": "node --experimental-strip-types src/lib/activeTarget.test.ts",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@lucide/vue": "^1.24.0",
    "@tanstack/vue-form": "^1.33.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
